# Copy into a secure deployment secret store. Never commit the populated file.
# DATABASE_URL is the app/workers DML role and should not own the schema.
# A Supabase session pooler may be used for persistent app processes if required.
DATABASE_URL=postgresql://megalodon_runtime:<URL_ENCODED_PASSWORD>@<SUPABASE_SESSION_POOLER_HOST>:<PORT>/postgres?sslmode=require

# Alembic only. Use the Supabase postgres/owner account or a role that owns the migrated objects.
# DDL grants alone may not allow ALTER TABLE; this username MUST differ from runtime.
MIGRATION_DATABASE_URL=postgresql://megalodon_migrator:<URL_ENCODED_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require

# The application maps sslmode=require to a verified TLS context.
DATABASE_SSL_MODE=verify-full
# Optional path inside the container to a trusted CA bundle; leave blank when system roots suffice.
DATABASE_SSL_ROOT_CERT=

# Supabase Storage is private and accessed only by the backend service identity.
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_KEY=<STORE_AS_SECRET>
SUPABASE_BUCKET_BIM=bim-modelos
SUPABASE_BUCKET_DOCUMENTOS=documentos
SUPABASE_BUCKET_EXPORTS=exportaciones

# Use managed Redis with TLS in production.
REDIS_URL=rediss://<REDIS_HOST>:<PORT>/0
CELERY_BROKER_URL=rediss://<REDIS_HOST>:<PORT>/1
CELERY_RESULT_BACKEND=rediss://<REDIS_HOST>:<PORT>/2

ENVIRONMENT=production
