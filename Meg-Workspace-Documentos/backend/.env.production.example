# Copy to .env.production; never commit the populated file.
# Pass it explicitly: docker compose --env-file .env.production -f docker-compose.prod.yml ...
ENVIRONMENT=production
SECRET_KEY=
# New installations: use an independent encryption key and keep a recoverable copy.
# Existing encrypted data: preserve its effective old key until a verified DEK re-wrap.
ENCRYPTION_MASTER_KEY=
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Runtime uses a DML role; MIGRATION_DATABASE_URL uses the DDL role.
# Replace both URLs and verify PostgreSQL TLS before using a hosted database.
DATABASE_URL=postgresql+asyncpg://megalodon:${POSTGRES_PASSWORD}@db:5432/megalodon
MIGRATION_DATABASE_URL=postgresql+asyncpg://megalodon:${POSTGRES_PASSWORD}@db:5432/megalodon
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_BACKEND_ENDPOINT=
OTEL_BACKEND_AUTH_HEADER=
OTEL_SERVICE_NAME=megalodon-api
REDIS_FAILURE_POLICY=closed
# Pydantic list fields require JSON in the process environment.
CORS_ALLOWED_ORIGINS='["https://app.example.com"]'

# Provide reviewed PEM bundles outside Git; compose mounts this directory read-only.
# roots.pem contains approved signer/TSA trust anchors; intermediates.pem contains
# intermediates only. Never put private .key files or passwords in this directory.
FIEL_TRUST_BUNDLE_DIR=./fiel-trust
FIEL_TRUST_ROOT_PATHS='["/run/megalodon/fiel-trust/roots.pem"]'
FIEL_INTERMEDIATE_CERT_PATHS='["/run/megalodon/fiel-trust/intermediates.pem"]'
TSA_ALLOWED_URLS='["http://timestamp.digicert.com"]'
# Enable only after outbound AIA/OCSP/CRL access has been reviewed and allowed.
# LTV signing remains fail-closed when current revocation evidence is unavailable.
FIEL_ALLOW_REVOCATION_FETCHING=false
# Optional provider credentials; unavailable sources stay explicitly unavailable.
ADSBEXCHANGE_API_KEY=
AISSTREAM_API_KEY=
OPENSKY_USER=
OPENSKY_PASS=
WEBODM_URL=
WEBODM_TOKEN=
